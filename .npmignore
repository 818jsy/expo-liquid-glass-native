# Tarballs and local package manager state
/*.tgz
/node_modules/
/.npm/

# Test and local-only files
__mocks__/
__tests__/
/babel.config.js
/example/
/assets/

# Android generated artifacts and IDE metadata
/android/.gradle/
/android/build/
/android/bin/
/android/.classpath
/android/.project
/android/.settings/
/android/*.iml
/android/local.properties
/android/**/.cxx/

# iOS generated artifacts
/ios/build/

# Generic generated or editor files
**/.DS_Store
**/.gradle/
**/build/
**/bin/
**/.classpath
**/.project
**/.settings/
**/*.iml

# Keep only runtime native sources under android
/android/src/androidTest/
/android/src/test/
